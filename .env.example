# =====================================
# PORTFOLIO BACKEND - ENVIRONMENT FILE
# =====================================
# Copy this file to .env and fill in your values
# Never commit .env to version control!

# =====================================
# Server Configuration
# =====================================
NODE_ENV=development
PORT=3001

# =====================================
# Database Configuration (PostgreSQL)
# =====================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=portfolio_db
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password_here
DB_DIALECT=postgres
DB_LOGGING=false

# =====================================
# JWT Configuration
# =====================================
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your-refresh-token-secret-change-in-production-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# =====================================
# Admin Credentials (Default Admin)
# =====================================
ADMIN_EMAIL=admin@logan.dev
ADMIN_PASSWORD=SecurePassword123!

# =====================================
# Email Configuration (SMTP)
# =====================================
# For Gmail: Enable "Less secure app access" or use App Password
# https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-specific-password
EMAIL_FROM="Yao David Logan <noreply@logan.dev>"

# =====================================
# Frontend URL (for CORS)
# =====================================
FRONTEND_URL=http://localhost:3000

# =====================================
# Frontend cache revalidation
# =====================================
# Must match frontend REVALIDATE_SECRET
REVALIDATE_SECRET=
# Optional override. Default: FRONTEND_URL + /api/revalidate
FRONTEND_REVALIDATE_URL=http://localhost:3000/api/revalidate

# =====================================
# Rate Limiting
# =====================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =====================================
# Logging
# =====================================
# Levels: error, warn, info, http, verbose, debug, silly
LOG_LEVEL=debug

# =====================================
# Backup (see backend/docs/BACKUP.md)
# =====================================
# Master switch — set to "true" to activate the cron job logic
BACKUP_ENABLED=false
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=3
BACKUP_INCLUDE_LOGS=true
# Reserved for later when an uploads/ directory exists
BACKUP_INCLUDE_UPLOADS=false
BACKUP_UPLOADS_PATH=./uploads

# --- Notifications (all optional) ---
# If empty, only the file log (logs/backup.log) is written
BACKUP_NOTIFY_EMAIL=
BACKUP_NOTIFY_DISCORD_WEBHOOK=

# --- S3-compatible destination (AWS S3 / Cloudflare R2 / Backblaze B2 / MinIO) ---
# Leave BACKUP_S3_BUCKET empty to disable
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=auto
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_PREFIX=portfolio-backups

# --- SFTP destination ---
# Leave BACKUP_SFTP_HOST empty to disable
BACKUP_SFTP_HOST=
BACKUP_SFTP_PORT=22
BACKUP_SFTP_USER=
BACKUP_SFTP_PASSWORD=
BACKUP_SFTP_KEY_PATH=
BACKUP_SFTP_REMOTE_DIR=/backups/portfolio

# --- Google Drive via rclone ---
# Leave BACKUP_GDRIVE_RCLONE_REMOTE empty to disable
# Setup: see docs/BACKUP.md (rclone config + OAuth)
BACKUP_GDRIVE_RCLONE_REMOTE=
BACKUP_GDRIVE_REMOTE_DIR=portfolio-backups
