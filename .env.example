# =====================================
# PORTFOLIO BACKEND - LOCAL ENV TEMPLATE
# =====================================
# Local development template.
# Do not place real production secrets here if this file is meant to be committed.
# Keep real values in an untracked `.env` or in your hosting provider secrets panel.

# =====================================
# Server Configuration
# =====================================
# Runtime mode used by Express, Sequelize and logs.
NODE_ENV=development

# Backend API port.
PORT=3002

# Create the PostgreSQL database automatically if it does not exist.
DB_AUTO_CREATE=true

# Synchronize Sequelize models automatically.
# Useful locally; production should eventually use migrations.
DB_AUTO_SYNC=true

# =====================================
# Database Configuration - PostgreSQL
# =====================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=portfolio_db
DB_USERNAME=postgres
DB_PASSWORD=change_me
DB_DIALECT=postgres
DB_LOGGING=false

# =====================================
# JWT Configuration
# =====================================
# Admin access token secret.
JWT_SECRET=change_me_access_secret
JWT_EXPIRES_IN=24h

# Admin refresh token secret.
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# =====================================
# Admin Credentials
# =====================================
# Default admin account used by setup/seed scripts.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_admin_password

# =====================================
# Email / SMTP Configuration
# =====================================
MAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=mailbox@example.com
EMAIL_PASS=change_me_email_password
EMAIL_FROM="Portfolio <noreply@example.com>"

# =====================================
# Frontend URLs - CORS
# =====================================
# Comma-separated browser origins allowed to call the backend.
# Usually: public frontend + admin app.
FRONTEND_URL=http://localhost:3000,http://localhost:3001

# =====================================
# Frontend Cache Revalidation
# =====================================
# Must match the frontend REVALIDATE_SECRET.
REVALIDATE_SECRET=change_me_same_value_as_frontend

# Explicit Next.js revalidation endpoint.
FRONTEND_REVALIDATE_URL=http://localhost:3000/api/revalidate

# =====================================
# Rate Limiting
# =====================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =====================================
# Owner / Public Profile Defaults
# =====================================
OWNER_NAME=Yao David Logan
OWNER_EMAIL=owner@example.com
OWNER_PHONE=+000000000000
OWNER_LOCATION=Lome, Togo

# =====================================
# Visitor OTP / JWT
# =====================================
VISITOR_JWT_SECRET=change_me_visitor_secret
VISITOR_JWT_EXPIRES_IN=24h
VISITOR_JWT_REMEMBER_EXPIRES_IN=7d

# =====================================
# Logging
# =====================================
# Available levels: error, warn, info, http, verbose, debug, silly.
LOG_LEVEL=debug

# =====================================
# OpenAI / AI Providers
# =====================================
# Leave empty to disable AI features locally.
OPEN_ORG=
OPEN_KEY=
OPEN_ROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001
ELEVENLABS_API_KEY=

# =====================================
# Backup System
# =====================================
# Master switch for backup scripts/cron.
BACKUP_ENABLED=false

# Backup retention policy.
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=3

# Backup content toggles.
BACKUP_INCLUDE_LOGS=true
BACKUP_INCLUDE_UPLOADS=false
BACKUP_UPLOADS_PATH=./uploads

# =====================================
# Backup Notifications
# =====================================
BACKUP_NOTIFY_EMAIL=
BACKUP_NOTIFY_DISCORD_WEBHOOK=
BACKUP_VERBOSE_NOTIFY=false

# =====================================
# Backup Destination - S3 Compatible
# =====================================
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=auto
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_PREFIX=portfolio-backups

# =====================================
# Backup Destination - SFTP
# =====================================
BACKUP_SFTP_HOST=
BACKUP_SFTP_PORT=22
BACKUP_SFTP_USER=
BACKUP_SFTP_PASSWORD=
BACKUP_SFTP_KEY_PATH=
BACKUP_SFTP_REMOTE_DIR=/backups/portfolio

# =====================================
# Backup Destination - Google Drive via rclone
# =====================================
BACKUP_GDRIVE_RCLONE_REMOTE=
BACKUP_GDRIVE_REMOTE_DIR=portfolio-backups

# =====================================
# Asset Upload Storage
# =====================================
# Admin-only image upload for projects, blog posts and experiences.
# Uploaded images are converted to optimized WebP before being sent to FTP.
# Leave FTP_HOST / FTP_USER / FTP_PASSWORD empty to disable uploads while keeping URL fields usable.
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=
FTP_SECURE=false

# Remote FTP directory where optimized images are stored.
# Example: /upload
FTP_UPLOAD_DIR=/upload

# Public URL matching FTP_UPLOAD_DIR. The backend returns URLs based on this value.
# Example final URL: https://bulk.*.com/upload/blog/2026/05/article-cover-id.webp
FTP_PUBLIC_BASE_URL=https://bulk.*.com/upload

# Upload validation and optimization.
ASSET_MAX_FILE_SIZE_MB=10
ASSET_MAX_WIDTH=1800
ASSET_QUALITY=82
